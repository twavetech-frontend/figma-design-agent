{
  "permissions": {
    "allow": [
      "Bash",
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "mcp__figma-tools",
      "mcp__paper",
      "mcp__pencil"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "figma-tools"
  ],
  "env": {
    "FIGMA_MCP_SKIP_ENHANCE": "1",
    "FIGMA_MCP_REQUEST_TIMEOUT": "600"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/planning_read_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|mcp__figma-tools__export_node_as_image",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/planning_read_hook.py\""
          }
        ]
      }
    ]
  }
}
